      "audioUrl": "",
      "options": [
        {
          "id": "o-96b622fdc1be",
          "text": "study",
          "correct": false,
          "comment": "С she нужно окончание -s."
        },
        {
          "id": "o-cc5e38f98d1c",
          "text": "studies",
          "correct": true,
          "comment": "Верно: в Present Simple с he/she/it добавляем -s."
        },
        {
          "id": "o-823fa515d451",
          "text": "is study",
          "correct": false,
          "comment": "Это смесь двух времён, так не говорят."
        }
      ],
      "answers": [],
      "explanation": "Present Simple: после she/he/it глагол получает -s — she studies.",
